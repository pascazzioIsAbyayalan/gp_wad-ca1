{{> menu id="about"}}

<section class="ui left aligned middle aligned segment">
  
    <h2>About the Playlist App</h2>
      <p>
        This App was made from the Brotherhood, for the
        Brotherhood. It is a simple App to keep track
        of the videogames you discover from the AC franchise. It is a compilation of the information gathered from the start off the Assassins' Creed franchise to the lore we have today..
        </p>
        <p>
          Meet the team of Master Assasins:
        </p>

{{#each employees}}
<div class="ui centered card">
  <div class="image">
    <img src="{{image}}">
  </div>
  <div class="content">
    <a class="header">{{fullname}}</a>
    <div class="meta">
      <span class="date">Joined in {{joined}}</span>
    </div>
    <div class="description">
        is an {{job}} living in {{city}}.
    </div>
  </div>
  <div class="extra content">
    <a>
      <i class="user icon"></i>
        {{mates}} contacts
    </a>
  </div>
</div>

{{/each}}
</section>